# Health check message
PING_MESSAGE=pong

# Local development only. Never set this on a deployed site.
# AUTH_DISABLED=true

# Production: persistent Postgres and a stable session secret
# (generate one with `openssl rand -hex 32`).
# DATABASE_URL=
# BETTER_AUTH_SECRET=

# Signs agent-to-agent calls and, on Netlify, the dispatch to its 15-minute
# background function. Generate one with `openssl rand -hex 32`.
# A2A_SECRET=

# Do not set AGENT_CHAT_DURABLE_BACKGROUND on Vercel: it has no background
# function, and agent turns stop at the 40-second limit instead of continuing.

# Vercel only: authenticates the scheduled sweep. Generate it the same way.
# CRON_SECRET=

# LLM provider for the agent. Users can also add their own key in Settings.
# ANTHROPIC_API_KEY=

# Optional token with no scopes, used only to raise GitHub's rate limit on public
# data. Tokens for acting on a repository belong to each user, set in Settings.
# GITHUB_PUBLIC_READ_TOKEN=
